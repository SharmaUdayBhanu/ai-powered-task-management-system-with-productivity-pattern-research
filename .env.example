# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# MongoDB (required in production)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/dbname

# AI (Groq — used by serverless API routes under /api/gemini and productivity)
GROQ_API_KEY=
# Optional override (defaults are set in server code)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional MongoDB tuning
# MONGO_SERVER_SELECTION_TIMEOUT_MS=12000
# MONGO_CONNECT_TIMEOUT_MS=12000
# MONGO_SOCKET_TIMEOUT_MS=15000
# MONGO_MAX_POOL_SIZE=5

# --- Client (Vite) — prefix with VITE_ ; set in Vercel for the *client* build if needed ---
# Same deployment: leave empty so the browser calls /api on the same host.
# VITE_API_URL=
#
# Split deployments: point to your API origin (no trailing slash).
# VITE_API_URL=https://your-api.example.com
#
# Socket.IO does not run on Vercel serverless; keep disabled for production there.
# VITE_ENABLE_REALTIME=false
